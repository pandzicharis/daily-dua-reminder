# =========================================================================
# Kopiraj u .env.local za lokalni rad (vercel dev), a na Vercelu ih unesi
# kroz Project → Settings → Environment Variables.
# .env.local se NIKAD ne commituje.
# =========================================================================

# --- VAPID (Web Push potpis) ---------------------------------------------
# Generiši jednom:  npx web-push generate-vapid-keys
# Javni ključ ide u browser (preko /api/config), privatni NIKAD.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Mora biti mailto: adresa ili https URL — push servisi traže kontakt.
VAPID_SUBJECT=mailto:haris.pandzic@bloomteq.com

# --- Baza (Upstash Redis preko REST-a) -----------------------------------
# Vercel → Storage → Upstash Redis ove dvije varijable doda sam.
# Ako praviš bazu direktno na upstash.com, imena su UPSTASH_REDIS_REST_*
# i kod prihvata oba.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Zajednički prostor --------------------------------------------------
# Ime prostora u kojem svi uređaji dijele isti spisak čekiranog.
# Ne mora se postavljati — default je "zajedno". Mijenjaj samo ako trebaš
# potpuno odvojeno stanje (druga osoba, drugi deploy).
# ZIKR_SPACE=zajedno

# --- Cron ----------------------------------------------------------------
# Bilo koji dug nasumičan string:  openssl rand -hex 32
# Bez njega /api/cron vraća 401 i scheduler ne radi.
CRON_SECRET=

# --- Razmak između podsjetnika -------------------------------------------
# PRODUKCIJA: 60 (jedan podsjetnik na sat).
# TESTIRANJE: 1  (cijeli ciklus se vidi za par minuta).
REMINDER_INTERVAL_MINUTES=60

# --- Samo za testiranje (ne postavljati u produkciji) ---------------------
# Pomjera startTime SVIH zadataka na ovo vrijeme, da ne moraš čekati 07:00.
# REMINDER_START_TIME=00:00
